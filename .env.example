# Copy to .env and change the values. .env is git-ignored.

# Which engine you started (read by run_all.sh): oracle | postgres | mysql
DB_ENGINE=oracle

# Application user, shared by all engines (Oracle: user in FREEPDB1; Postgres/MySQL: user + database)
APP_USER=app
APP_PASSWORD=app
APP_DB=app

# Oracle
ORACLE_PASSWORD=ChangeMe_Sys_1
ORACLE_PORT=1521

# PostgreSQL
POSTGRES_PORT=5432

# MySQL
MYSQL_ROOT_PASSWORD=ChangeMe_Root_1
MYSQL_PORT=3306
